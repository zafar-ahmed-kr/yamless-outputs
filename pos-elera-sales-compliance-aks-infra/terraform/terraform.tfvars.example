# terraform.tfvars.example — generated by YAMLess for pos-elera-sales-compliance (target: aks)
# Copy to terraform/terraform.tfvars and fill in real values before running terraform plan.
# Never commit terraform.tfvars to version control — it may contain sensitive inputs.

# ── Required ──────────────────────────────────────────────────────────────────

# Full image URI from Azure Container Registry. Must include an immutable tag (Git SHA or semver).
# Never use :latest in production (enforced by governance check GR-SEC-008).
image = "myacr.azurecr.io/pos-elera-sales-compliance:abc1234"

# ── Identity & environment ────────────────────────────────────────────────────

app_name    = "pos-elera-sales-compliance"
environment = "production"   # dev | staging | production
location    = "uksouth"             # Azure region — change to match your landing zone
namespace   = "pos-elera-sales-compliance"      # Kubernetes namespace for the workload

# ── Governance tags ───────────────────────────────────────────────────────────
# Required in production (GR-COST-001 / GR-OPS-005).
# Governance checks P-09 and P-10 will warn if these are empty when environment=production.

cost_center = ""   # e.g. "PLAT-001"
team        = ""   # e.g. "platform"
owner       = ""   # e.g. "platform-eng@company.com"
runbook_url = ""   # e.g. "https://wiki.company.com/runbooks/pos-elera-sales-compliance"