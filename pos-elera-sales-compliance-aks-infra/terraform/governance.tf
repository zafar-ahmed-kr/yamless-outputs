# governance.tf  —  Policy-as-Code  —  generated by YAMLess
# Terraform >= 1.5 required for check blocks; >= 1.4 for terraform_data.
#
# Three enforcement layers:
#   1. lifecycle.precondition inside modules → BLOCKS terraform plan
#   2. resource "terraform_data" "governance_gate" → BLOCKS terraform plan (variable checks)
#   3. check blocks below → ADVISORY WARNINGS ONLY (do NOT block apply)

locals {
  _generated_for_env = "production"
  _is_production     = var.environment == "production"
  _required_tag_keys = toset(["app_name", "environment", "managed_by"])
}

check "P00_environment_lock" {
  assert {
    condition     = var.environment == local._generated_for_env
    error_message = "P-00 VIOLATION: stack generated for '${local._generated_for_env}' but var.environment='${var.environment}'. Re-run yamless generate."
  }
}

check "P01_mandatory_tags" {
  assert {
    condition     = local._required_tag_keys == setintersection(local._required_tag_keys, toset(keys(local.tags)))
    error_message = "P-01 VIOLATION: local.tags missing required keys: app_name, environment, managed_by."
  }
}

check "P02_resource_group_naming" {
  assert {
    condition     = startswith(azurerm_resource_group.main.name, "rg-")
    error_message = "P-02 VIOLATION: resource group must follow rg-<app>-<env> naming convention."
  }
}


check "P04_redis_production_sku" {
  assert {
    condition     = !local._is_production || module.redis.sku_name == "Premium"
    error_message = "P-04 VIOLATION: production Redis must use Premium SKU."
  }
}

# ─── P-05  Production HTTP: min_replicas >= 2 ────────────────────────────────
# GR-REL-001: Single-replica HTTP services are a single point of failure in K8s.
check "P05_production_min_replicas" {
  assert {
    condition     = !local._is_production || 1 >= 2
    error_message = "P-05 VIOLATION (GR-REL-001): production http-service has min_replicas=1. Minimum 2 required for zero-downtime rolling deployments."
  }
}

# ─── P-06  Autoscaling: max_replicas > min_replicas in production ─────────────
# GR-COST-003: HPA requires max > min to have any scaling headroom.
check "P06_autoscaling_configured" {
  assert {
    condition     = !local._is_production || 10 > 1
    error_message = "P-06 VIOLATION (GR-COST-003): production HTTP max_replicas=10 == min_replicas=1. Increase max_replicas to enable HPA scaling."
  }
}



# ─── P-09  Runbook URL required for production ────────────────────────────────
# Also enforced at plan time by terraform_data.governance_gate below.
check "P09_runbook_url_production" {
  assert {
    condition     = !local._is_production || length(var.runbook_url) > 0
    error_message = "P-09 VIOLATION (GR-OPS-005): var.runbook_url is empty. Create a runbook and set this variable before applying to production."
  }
}

# ─── P-10  Cost governance tags required for production ──────────────────────
# Also enforced at plan time by terraform_data.governance_gate below.
check "P10_cost_governance_tags" {
  assert {
    condition     = !local._is_production || (length(var.cost_center) > 0 && length(var.team) > 0 && length(var.owner) > 0)
    error_message = "P-10 VIOLATION (GR-COST-001): production service missing cost tags. Set var.cost_center, var.team, and var.owner."
  }
}

# ─── Plan-time blocking gate ─────────────────────────────────────────────────
resource "terraform_data" "governance_gate" {
  lifecycle {
    precondition {
      condition     = !local._is_production || length(var.runbook_url) > 0
      error_message = "GR-OPS-005 PLAN BLOCKED: var.runbook_url is required in production. Create a runbook and set this variable."
    }
    precondition {
      condition     = !local._is_production || (length(var.cost_center) > 0 && length(var.team) > 0 && length(var.owner) > 0)
      error_message = "GR-COST-001 PLAN BLOCKED: var.cost_center, var.team, and var.owner are required in production."
    }
  }
}

output "governance_metadata" {
  description = "YAMLess governance metadata for audit pipelines."
  value = {
    generated_for_environment = local._generated_for_env
    applied_environment       = var.environment
    policy_version = "1.1"
    managed_by     = "yamless"
    active_checks  = compact([
      "P-00 environment-lock",
      "P-01 mandatory-tags",
      "P-02 resource-naming",
      "P-04 redis-sku (GR-COST-002)",
      "P-05 min-replicas (GR-REL-001)",
      "P-06 autoscaling-configured (GR-COST-003)",
      "P-09 runbook-url (GR-OPS-005)",
      "P-10 cost-governance-tags (GR-COST-001)",
    ])
  }
}