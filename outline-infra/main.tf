# Generated by YAMLess — do not edit manually.
# App: outline | Shape: http-service | Runtime: node

locals {
  app_name    = var.app_name
  environment = var.environment
  location    = var.location
  tags = {
    app_name    = local.app_name
    environment = local.environment
    runtime     = "node"
    shape       = "http-service"
    managed_by  = "yamless"
  }
}

resource "azurerm_resource_group" "main" {
  name     = "rg-${local.app_name}-${local.environment}"
  location = local.location
  tags     = local.tags
}

# ── Identity ────────────────────────────────────────────────────────────────

module "managed_identity" {
  source              = "./modules/managed_identity"
  app_name            = local.app_name
  environment         = local.environment
  location            = local.location
  resource_group_name = azurerm_resource_group.main.name
  tags                = local.tags
}

# ── Key Vault ────────────────────────────────────────────────────────────────

module "keyvault" {
  source                        = "./modules/keyvault"
  app_name                      = local.app_name
  environment                   = local.environment
  location                      = local.location
  resource_group_name           = azurerm_resource_group.main.name
  tags                          = local.tags
  managed_identity_principal_id = module.managed_identity.principal_id
}

# ── Container App Environment ────────────────────────────────────────────────

module "container_app_env" {
  source              = "./modules/container_app_env"
  app_name            = local.app_name
  environment         = local.environment
  location            = local.location
  resource_group_name = azurerm_resource_group.main.name
  tags                = local.tags
}

# ── PostgreSQL ───────────────────────────────────────────────────────────────

module "postgres" {
  source              = "./modules/postgres"
  app_name            = local.app_name
  environment         = local.environment
  location            = local.location
  resource_group_name = azurerm_resource_group.main.name
  tags                = local.tags
  keyvault_id         = module.keyvault.id
  keyvault_rbac_ready = module.keyvault
}

# ── Storage ──────────────────────────────────────────────────────────────────

module "storage" {
  source                        = "./modules/storage"
  app_name                      = local.app_name
  environment                   = local.environment
  location                      = local.location
  resource_group_name           = azurerm_resource_group.main.name
  tags                          = local.tags
  managed_identity_principal_id = module.managed_identity.principal_id
  keyvault_id                   = module.keyvault.id
  keyvault_rbac_ready           = module.keyvault
}


# ── Container App ────────────────────────────────────────────────────────────

module "container_app" {
  source                       = "./modules/container_app"
  app_name                     = local.app_name
  environment                  = local.environment
  resource_group_name          = azurerm_resource_group.main.name
  tags                         = local.tags
  container_app_environment_id = module.container_app_env.id
  managed_identity_id          = module.managed_identity.id
  managed_identity_client_id   = module.managed_identity.client_id
  image                        = var.image
  target_port                  = 3000
  ingress_external             = true
  min_replicas                 = 1
  max_replicas                 = 10
  scale_trigger                = "http"
  keyvault_uri                 = module.keyvault.uri
  keyvault_secret_names        = ["database-url", "storage-connection-string", "aws-cloudfront-private-key", "aws-container-authorization-token", "aws-secret-access-key", "azure-client-secret", "github-app-private-key", "github-client-secret", "github-webhook-secret", "redis-url", "secret-key", "slack-client-secret", "slack-verification-token"]
}